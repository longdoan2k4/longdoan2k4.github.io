{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
  {{- if eq .Type "posts" -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "uri" .RelPermalink "url" .Permalink "tags" .Params.tags "categories" .Params.categories "content" (.Plain | truncate 500) "summary" .Summary "date" (.Date.Format "2006-01-02")) -}}
  {{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}